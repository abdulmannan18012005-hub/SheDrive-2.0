{
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "jsx": "react-native",
    "moduleResolution": "node",
    "target": "es2022",
    "module": "commonjs",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
